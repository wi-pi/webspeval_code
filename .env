# ============================================================
# Backbone model API access (fill in whichever providers you use)
# ============================================================
# OpenAI / Azure OpenAI (GPT-5.x family)
OPENAI_API_KEY=
AZURE_OPENAI_KEY=
ENDPOINT_URL=                 # Azure OpenAI endpoint, e.g. https://<resource>.openai.azure.com/

# Google Gemini (AI Studio API key OR Vertex AI)
GEMINI_API_KEY=
VERTEX_AI_LOCATION=           # e.g. us-east5 / global
VERTEX_AI_PROJECT_ID=         # your GCP project id

# Anthropic Claude — accessed via Vertex AI in this codebase (uses VERTEX_AI_* above)

# Open-weight models via OpenRouter (e.g. Gemma)
OPENROUTER_API_KEY=

# ============================================================
# Sock-puppet account used for state-reset / replay
# (you create your OWN accounts — see docs/ACCOUNT_SETUP.md)
# ============================================================
# Used to substitute the {{WEBSP_ACCOUNT_*}} placeholders inside the shipped
# state-reset traces at replay time (see tools/templatize_traces.py).
WEBSP_ACCOUNT_EMAIL=          # the email of YOUR Google sock-puppet account
WEBSP_ACCOUNT_USERNAME=       # the username portion / handle of your account
WEBSP_ACCOUNT_NAME=           # the display name on your account

# API-based state reset for code-hosting tasks (create your own tokens)
HF_TOKEN=
HF_USERNAME=
GITHUB_TOKEN=
GITHUB_USERNAME=

# Optional: captcha alerts during long runs (used by src/utils.py).
# Full URL — e.g. an ntfy.sh topic: https://ntfy.sh/<your-topic>. Leave blank to disable.
NTFY_TOPIC_URL=

# Optional: S3 bucket to mirror run outputs (only used with the --upload_to_s3 flag). Blank = off.
AWS_S3_BUCKET=
